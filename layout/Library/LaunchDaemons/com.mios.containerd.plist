<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.mios.containerd</string>
	<key>Program</key>
	<string>/var/jb/usr/libexec/miosd</string>
	<key>UserName</key>
	<string>root</string>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>ProcessType</key>
	<string>Interactive</string>
	<key>EnvironmentVariables</key>
	<dict>
		<!-- Keep MobileSubstrate / ellekit from injecting tweaks into our own daemon (Crane does the
		     same); an injected tweak crashing here would take the daemon down before it can log. -->
		<key>_MSSafeMode</key>
		<string>1</string>
		<key>_SafeMode</key>
		<string>1</string>
	</dict>
</dict>
</plist>
